# Copy to .env.local (never commit real values). Server-side only unless prefixed VITE_.

# LLM access — one gateway key covers all providers (Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Or direct provider keys if not using the gateway
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# Later: XAI_API_KEY=  (Meta Llama / Qwen usually via the gateway)

# Supabase (project llm-voxel-world). The public URL + anon key have built-in defaults in
# src/engine/config.ts; set these only to point at a different project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only (Vercel functions in later phases). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Game
VITE_WORLD_SEED=20261110
DIARY_MODE=real_day          # real_day | game_day
CRON_SECRET=
