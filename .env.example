# Copy to .env.local (never commit real values). Server-side only unless prefixed VITE_.

# --- LLM brains (server-side only, used by /api/agent/think) ---
# MiniMax (OpenAI-compatible). Any OpenAI-compatible provider works via AGENT_BASE_URL + AGENT_MODEL.
MINIMAX_API_KEY_1=
AGENT_BASE_URL=https://api.minimax.io/v1
AGENT_MODEL=MiniMax-M3.1-Flash
AGENT_REASONING_EFFORT=low
# Which characters may use the LLM (comma separated). Others keep scripted brains.
AGENT_LLM_AGENTS=clio
# Cost guard (shared by ALL visitors): daily budget in USD (Asia/Taipei day) and global calls per minute.
AGENT_DAILY_BUDGET_USD=0.5
AGENT_MAX_CALLS_PER_MIN=20
# Shared secret for the Supabase agent_budget / agent_log_think RPCs. Required — without it no LLM call is made.
AGENT_DB_SECRET=

# Supabase (project llm-voxel-world). The public URL + anon key have built-in defaults in
# src/engine/config.ts; set these only to point at a different project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only (Vercel functions in later phases). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Game
VITE_WORLD_SEED=20261110
DIARY_MODE=real_day          # real_day | game_day
CRON_SECRET=
